---
import Workspace from "../components/Workspace.svelte";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Create OVAL definitions and XCCDF profiles locally in your browser."
    />
    <title>Kade's VM Toolbox</title>
    <script is:inline>
      (() => {
        try {
          const mode = localStorage.getItem("toolbox:theme") || "system";
          const dark =
            mode === "dark" ||
            (mode === "system" &&
              matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
          document.documentElement.dataset.themeMode = mode;
          const themeColor =
            localStorage.getItem("toolbox:theme-color") ||
            localStorage.getItem("toolbox:accent");
          if (/^#[0-9a-f]{6}$/i.test(themeColor || "")) {
            localStorage.setItem("toolbox:theme-color", themeColor);
            localStorage.removeItem("toolbox:accent");
            const red = parseInt(themeColor.slice(1, 3), 16);
            const green = parseInt(themeColor.slice(3, 5), 16);
            const blue = parseInt(themeColor.slice(5, 7), 16);
            const luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue;
            const style = document.documentElement.style;
            style.setProperty("--accent", themeColor);
            style.setProperty(
              "--accent-soft",
              `rgb(${red} ${green} ${blue} / 18%)`,
            );
            style.setProperty(
              "--accent-hover",
              `color-mix(in srgb, ${themeColor} 82%, black)`,
            );
            style.setProperty(
              "--accent-contrast",
              luminance > 150 ? "#111827" : "#ffffff",
            );
          }
        } catch {
          const dark = matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = dark ? "dark" : "light";
          document.documentElement.dataset.themeMode = "system";
        }
      })();
    </script>
  </head>
  <body>
    <Workspace client:only="svelte" />
  </body>
</html>
